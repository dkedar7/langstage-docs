[33.5535, "o", "\u001b[36m\u23fa\u001b[0m Confirmed: deploy at 14:01:55 shrank pool_size 20\u21925 and max_overflow 10\u21920; errors start at 14:02:13 (engine created) then 14:02:52 (first timeout), matching exactly. Fixing by restoring prior pool settings.\r\n\u001b[32m\u25cf apply_config_change\u001b[0m\r\n  \u001b[2m\u2514\u2500 config/api.yaml\u001b[0m"]
[33.5542, "o", "\r\n"]
[33.6405, "o", "\r\n\u001b[33m\u26a0 Action Required\u001b[0m\r\n"]
[33.6408, "o", "  \u001b[2m1. apply_config_change\u001b[0m\r\n     \u001b[2m\u2514\u2500 path=config/api.yaml\u001b[0m\r\n     \u001b[2m   changes={\"db.pool_size\": 20, \"db.max_overflow\": 10}\u001b[0m\r\n     \u001b[2m   reason=v2.8.0 deploy (14:01:55) unintentionally reduced db pool_size 20->5 and max_over...\u001b[0m\r\n     \u001b[2m   description=Change production config config/api.yaml: db.pool_size -> 20, db.max_overflow ->...\u001b[0m\r\n"]
[33.641, "o", "\u001b[?25l\r\n\u001b[1mHow would you like to proceed?\u001b[0m\r\n  \u001b[36m\u276f Approve all actions\u001b[0m\r\n    \u001b[2mReject all actions\u001b[0m\r\n    \u001b[2mProvide custom decision (JSON)\u001b[0m\r\n    \u001b[2mExit\u001b[0m\r\n"]
